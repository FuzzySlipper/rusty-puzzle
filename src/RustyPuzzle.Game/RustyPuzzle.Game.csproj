<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <RustyEngineProductEntryType>RustyPuzzle.Game.RustyPuzzleProduct</RustyEngineProductEntryType>
    <RustyEngineProductId>rusty-puzzle</RustyEngineProductId>
    <RustyEngineProductTitle>Rusty Puzzle</RustyEngineProductTitle>
    <RustyEngineProductUiRoot>$(MSBuildProjectDirectory)/../ui</RustyEngineProductUiRoot>
    <RustyEngineProductUiEntry>main.js</RustyEngineProductUiEntry>
    <RustyEngineProductContentRoot>$(MSBuildProjectDirectory)/../../content</RustyEngineProductContentRoot>
    <RustyEngineProductUiProjectionStream>rusty-puzzle</RustyEngineProductUiProjectionStream>
    <RustyEngineProductUiProjectionContract>rusty.puzzle.board</RustyEngineProductUiProjectionContract>
    <!-- The board is turn-based, but its camera must refit when the page lays out or resizes the
         board view, and a demand product gets no update for a layout change (rusty-engine #9629).
         Realtime updates let the camera follow; an update without input only refits and redraws. -->
    <RustyEngineProductLifecycleMode>realtime</RustyEngineProductLifecycleMode>
    <RustyEngineProductFixedStepHz>60</RustyEngineProductFixedStepHz>
    <RustyEngineProductFixedStepMaxCatchUpSteps>4</RustyEngineProductFixedStepMaxCatchUpSteps>
    <!-- The pointer picks board cells, so the cursor stays free. -->
    <RustyEngineProductInputCursorMode>unlocked</RustyEngineProductInputCursorMode>
    <RustyEngineWatchPaths>$(MSBuildProjectDirectory);$(RustyEngineProductUiRoot);$(RustyEngineProductContentRoot)</RustyEngineWatchPaths>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Rusty.Engine" Version="[$(RustyEnginePackageVersion)]" />
    <!-- puzzle.command carries the DOM's puzzle.command.v1 payloads ({action, ...}; see Interface/PuzzleCommand.cs). -->
    <RustyEngineProductInputIntent Include="puzzle.command" Value="payload:puzzle.command.v1" />
    <InternalsVisibleTo Include="RustyPuzzle.Smoke" />
  </ItemGroup>

  <!-- Every content domain directory (content/rooms, content/party, ...) is its own Engine bundle named
       after the directory, so a new domain is a new directory. Each domain owner opens its own bundle.
       Under `rusty dev` a bundle edit restages without replacing the runtime; Restart reloads it. -->
  <ItemGroup>
    <_PuzzleContentDomain Include="$([System.IO.Directory]::GetDirectories('$(RustyEngineProductContentRoot)'))" />
    <RustyEngineContentBundle Include="@(_PuzzleContentDomain->'%(Filename)%(Extension)')" />
  </ItemGroup>
</Project>
